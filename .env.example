NODE_ENV=production
WA_DRY_RUN=true
WA_ENABLE_CONNECT=false
WA_SESSION_NAME=main
WA_LOG_LEVEL=info
WA_AUTH_DIR=auth/main
WA_PAIRING_PHONE=
WA_MEDIA_CACHE_DIR=data/media-cache
WA_MEDIA_RETENTION_HOURS=48

CANALBOT_ENABLE=true
CANALBOT_PUBLISH_ENABLED=false
CANALBOT_GLOBAL_SEND_DELAY_SECONDS=15
CANALBOT_GLOBAL_SEND_LEASE_SECONDS=300
CANALBOT_OUTBOUND_MIN_DELAY_MS=2500
CANALBOT_MAX_CAPTURE_ITEMS=200
CANALBOT_MAX_MEDIA_BYTES=67108864

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=canalbot
MYSQL_USER=canalbot
MYSQL_PASSWORD=replace-me
